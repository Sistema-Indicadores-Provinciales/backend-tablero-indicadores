MONGODB_URL=
# Same value in Nest and FastAPI; minimum 32 random characters in production.
JWT_SECRET=
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional legacy Sheets API access; public links now work without a key.
# Restrict any configured key to Sheets API.
GOOGLE_SHEETS_API_KEY=
# Optional alternative to Administration > Connections (analytics only, never VITE variables).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Fernet key. If empty, uses a Google-specific key derived from JWT_SECRET.
# Keep the chosen encryption key stable across deployments.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional persistent directory, defaults to analytics-service/storage.
ANALYTICS_STORAGE=
