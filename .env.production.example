# Copy to .env.production on the server; never commit the completed file.
MONGODB_URL=
# Random secret, at least 32 characters; shared by Nest and analytics.
JWT_SECRET=
PUBLIC_ORIGIN=https://indicadores.example.org
WEB_PORT=8080
# Optional legacy Sheets API key; public links need no key or account.
GOOGLE_SHEETS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
